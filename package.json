{
  "name": "lingoflow",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:api && bun run build:web",
    "build:api": "bun run --cwd apps/api build",
    "build:web": "bun run --cwd apps/web build",
    "dev:api": "bun run --cwd apps/api start:dev",
    "dev:web": "bun run --cwd apps/web dev",
    "prisma:generate": "bunx prisma generate --config apps/api/prisma7.config.ts",
    "prisma:validate": "bunx prisma validate --config apps/api/prisma7.config.ts",
    "seed": "bun apps/api/scripts/seed.ts"
  }
}
